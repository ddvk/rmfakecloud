# env variables
JWT_SECRET_KEY=tbd
DATADIR=/var/rmfakecloud/
#RM_SMTP_USER=
#RM_SMTP_ADDRESS=

# OIDC authentication (all four required to enable; also set RM_HTTPS_COOKIE=true)
#OIDC_PROVIDER_URL=https://sso.example.com
#OIDC_CLIENT_ID=rmfakecloud
#OIDC_CLIENT_SECRET=
#OIDC_REDIRECT_URL=https://your-domain.com/ui/api/oidc/callback
#RM_HTTPS_COOKIE=true
# Optional (values shown are defaults):
#OIDC_USERID_CLAIM=preferred_username
#OIDC_DISABLE_LOCAL_LOGIN=false
#OIDC_ALLOW_UNVERIFIED_EMAIL=false
#OIDC_EXTRA_SCOPES=
#OIDC_DISPLAY_NAME=Login with OIDC
# Optional (no default; unset means feature is disabled):
#OIDC_ADMIN_CLAIM=
#OIDC_ADMIN_CLAIM_VALUE=
